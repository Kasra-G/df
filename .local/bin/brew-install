#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s [--formula|--cask] PACKAGE [...]\n' "$0"
}

readonly brewfile="${DOTFILES_BREWFILE:-$HOME/.df/Brewfile}"
entry_type="--formula"
install_options=()

case "${1:-}" in
  --cask)
    entry_type="--cask"
    install_options=(--cask)
    shift
    ;;
  --formula)
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -*)
    usage >&2
    exit 2
    ;;
esac

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

if [[ ! -f "$brewfile" || ! -w "$brewfile" ]]; then
  printf 'Brewfile is missing or not writable: %s\n' "$brewfile" >&2
  exit 1
fi

command brew install "${install_options[@]}" "$@"

tracked_entries="$(command brew bundle list "$entry_type" --file="$brewfile")"
packages_to_add=()
for package in "$@"; do
  if ! grep -Fqx -- "$package" <<<"$tracked_entries"; then
    packages_to_add+=("$package")
  fi
done

if [[ ${#packages_to_add[@]} -gt 0 ]]; then
  command brew bundle add "$entry_type" --no-describe --file="$brewfile" "${packages_to_add[@]}"
fi
